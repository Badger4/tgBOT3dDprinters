# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=

# Server & WebApp Settings
HTTP_PORT=8080
WEBAPP_URL=
API_SECRET_KEY=
SSE_INTERVAL_SECONDS=5.0

# Project Paths
STORAGE_DIR=./printers_storage


# Secret token from the Cloudflare Tunnel dashboard. Keep only in the Pi's ignored .env.
CLOUDFLARE_TUNNEL_TOKEN=



# Cost Calculation Settings
ELECTRICITY_COST_PER_KWH=4.32

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
